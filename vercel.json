{
  "version": 2,
  "buildCommand": "cd react-frontend && npm run build",
  "outputDirectory": "react-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/react-frontend/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
